<% layout("layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3>
                <%= list.title %>
            </h3>
        </div>
        <div class="card col-6 offset-3 show-card listing-card">
            <img src=" <%= list.image %> " class="card-img-top show-img" alt="Listing image">
            <div class="card-body">
                <p class="card-text">
                    <i>Owned by</i> -<b><i>
                            <%= list.owner.username %>
                        </i></b>
                    <br>
                    <%= list.description %>
                        <br>
                        &#8377; <%= list.price.toLocaleString("en-IN") %>/night
                            <br>
                            <%= list.location %>
                                <br>
                                <%= list.country %>

                </p>
            </div>
        </div>

        <% if(currUser && currUser._id.equals(list.owner._id)) { %>
            <div class="btns mb-4 offset-1">
                <a href="/listing/<%= list._id %>/edit" class="btn btn-dark col-1 offset-2 edit-btn">Edit</a>
                <br>
                <form action="/listing/<%= list._id %>?_method=DELETE" method="post">
                    <button class="btn btn-dark offset-2">DELETE</button>
                </form>
            </div>
            <% } %>

    </div>

    <div class="col-8 offset-3 mb-3">
        <hr>
        <% if(currUser) { %>
            <h4>Leave a Review!</h4>
            <form action="/listing/<%= list.id %>/review" method="post" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range" required>
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea type="text" name="review[comment]" rows="5" cols="30" id="comment" class="form-control"
                        placeholder="Enter your Review!" required></textarea>
                    <div class="invalid-feedback">
                        Please add some feedback!
                    </div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
            <% } %>
                

                <p><b>ALL REVIEWS</b></p>
                <div class="row">
                    <% for(let review of list.reviews) { %>
                        <div class="card col-5 ms-3 mb-3">
                            <div class="card-body">
                                <div class="card-title">@<%= review.author.username %></div>
                                <pclass="card-text">
                                    <%= review.comment %>
                                        </p>
                                        <p class="card-text">
                                            <%= review.rating %>
                                        </p>
                            </div>
                            <form action="/listing/<%= list._id %>/review/<%=review._id %>?_method=DELETE"
                                method="post" class="mb-3">
                                <button class="btn btn-sm btn-dark">Delete</button>
                            </form>
                        </div>
                        <% } %>
                </div>
    </div>