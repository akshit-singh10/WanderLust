<% layout("layouts/boilerplate") %>

<div class="row mt-2">
    <div class="col-8 offset-2">
        <form action="/listing/<%= list._id %>?_method=PATCH" method="post" novalidate class="needs-validation">
            <h3>You Can Start Editing!</h3>
            <div class="mb-3 mt-2">
                <br><br>
                <label class="form-label" for="title">Enter title</label>
                <input type="text" name="listing[title]" id="title" placeholder="Add a catchy title" class="form-control" required
                    value="<%= list.title %>">
                <div class="valid-feedback">Title looks good!</div>
                <div class="invalid-feedback">Please add a title!</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" id="description" placeholder="Enter description" required
                    class="form-control"><%= list.description %></textarea>
                <div class="valid-feedback">Done, looks good!</div>
                <div class="invalid-feedback">Please add a description!</div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Image</label>
                <input type="text" name="listing[image]" id="image" placeholder="Enter image URL" class="form-control" required
                    value="<%= list.image %>">
            </div>

            <div class="row">
                <div class="mb-3 col-md-3">
                    <label for="price" class="form-label">Price</label>
                    <input type="text" min="0" name="listing[price]" id="price" placeholder="Enter price" class="form-control" required
                        value="<%= list.price %>">
                    <div class="valid-feedback">Price added!</div>
                    <div class="invalid-feedback">Please add a valid price!</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" id="country" placeholder="E.g.: India" class="form-control" required
                        value="<%= list.country %>">
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please add a country!</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" id="location" placeholder="E.g. : Mumbai" class="form-control" required
                    value="<%= list.location %>">
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please add a location!</div>
            </div>

            <button class="btn  save-btn">SAVE</button>
        </form>
    </div>
</div>
<br><br>
