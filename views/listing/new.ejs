<% layout("layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">
        <form action="/listing/" method="post" class="needs-validation" novalidate>
            <div class="mb-3 mt-2">
                <label class="form-label" for="title">Enter title</label>
                <input type="text" name="listing[title]" id="title" placeholder="Add a catchy title" class="form-control" required>
                <div class="valid-feedback">Title looks good!</div>
                <div class="invalid-feedback">Please add a title!</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" id="description" placeholder="Enter description"
                    class="form-control" required></textarea>
                <div class="valid-feedback">Done, looks good!</div>
                <div class="invalid-feedback">Please add a description!</div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Image</label>
                <input type="text" name="listing[image]" id="image" placeholder="Enter image URL" class="form-control">
            </div>

            <div class="row">
                <div class="mb-3 col-md-3">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" min="0" name="listing[price]" id="price" placeholder="Enter price" class="form-control" required>
                    <div class="valid-feedback">Price added!</div>
                    <div class="invalid-feedback">Please add a valid price!</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" id="country" placeholder="E.g.: India" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please add a country!</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" id="location" placeholder="E.g. : Mumbai" class="form-control" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please add a location!</div>
            </div>

            <br>
            <button class="btn btn-dark add-btn mb-3">ADD</button>
        </form>
    </div>
</div>