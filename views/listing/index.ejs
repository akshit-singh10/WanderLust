<% layout("layouts/boilerplate") %>

    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        }

        .filter {
            flex: 0 0 auto;
            text-align: center;
            margin-right: 2rem;
            margin-top: 1rem;
            opacity: 0.7;
            text-decoration: underline;
            text-decoration-color: transparent;
            text-underline-offset: 20px;
            transition: opacity 0.3s ease, text-decoration-color 0.4s ease;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
            text-decoration-color: black;
        }

        .filter p {
            font-size: 0.8rem;
        }

        .tax-info {
            display: none;
        }

        .tax-toggle {
            border: 2px solid gray;
            border-radius: 10px;
            height: 2.5rem;
            padding: 1rem;
            display: flex;
            align-items: center;
            margin-left: 3rem;
            transform: scale(0.8);

        }

        .filters-scroll {
            display: flex;
            flex-wrap: nowrap;
            /* items stay in one line, never wrap */
            overflow-x: auto;
            /* enables horizontal scroll/slide */
            scroll-behavior: smooth;
            /* smooth sliding when scrolled */
            flex: 1;
            /* takes up remaining space after tax-toggle */
        }

        .filters-scroll::-webkit-scrollbar {
            display: none;
        }

        .arrows {
            visibility: hidden;
        }

        #filters:hover .arrows {
            visibility: visible;
        }
    </style>


    <body>
        <!-- <h3 class="mt-3">ALL Listings</h3> -->
        <br>
        <!-- <form action="/listing/new" method="get">
        <button>Create New List</button>
    </form> -->
        <div id="filters">
            <p class="arrows"><i class="fa-solid fa-caret-left"></i></p>
            <div class="filters-scroll">
                <div class="filter">
                    <div><i class="fa-solid fa-fire"></i></div>
                    <p>Trending</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-bed"></i></div>
                    <p>Rooms</p>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-mountain-city"></i></div>
                    <p>Iconic</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-mountain"></i></div>
                    <p>Mountains</p>
                </div>
                <div class="filter">
                    <div><i class="fa-brands fa-fort-awesome"></i></div>
                    <p>Castles</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-person-swimming"></i></div>
                    <p>Swimming</p>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-campground"></i></div>
                    <p>Camping</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-cow"></i></div>
                    <p>Farms</p>
                </div>

                <div class="filter">
                    <div><i class="fa-regular fa-snowflake"></i></div>
                    <p>Arctic</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-cow"></i></div>
                    <p>Farms</p>
                </div>

                <div class="filter">
                    <div><i class="fa-regular fa-snowflake"></i></div>
                    <p>Arctic</p>
                </div>
                <div class="filter">
                    <div><i class="fa-solid fa-landmark-dome"></i></div>
                    <p>Domes</p>
                </div>

                <div class="filter">
                    <div><i class="fa-solid fa-sailboat"></i></div>
                    <p>Boats</p>
                </div>
            </div>
            <p class="arrows"><i class="fa-solid fa-caret-right"></i></p>

            <div class="tax-toggle">
                <div class="form-check form-switch  form-check-reverse">
                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Display Total after Taxes</label>
                </div>
            </div>
        </div>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <% for(let list of allList) { %>
                <a href="/listing/<%= list._id %>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%= list.image.url %>" class="card-img-top" alt="Listing Image"
                            style="height : 20rem;">
                        <div class="card-img-overlay">
                            <%= list.title %> 
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= list.title %>
                                </b>
                                <br>
                                &#8377 <%= list.price ? list.price.toLocaleString("en-IN") : "N/A" %> /night
                                    <i class="tax-info"> &nbsp; &nbsp; + 18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>

    </body>

    <script>
        let toggle = document.querySelector("#flexSwitchCheckDefault");
        toggle.addEventListener('click', () => {
            let taxes = document.getElementsByClassName("tax-info");
            for (let info of taxes) {
                if (info.style.display !== 'inline')
                    info.style.display = 'inline';
                else
                    info.style.display = 'none';
            }
        });
    </script>