<% layout("layouts/boilerplate") %>
    <body>
        <h3>ALL Listings</h3>
        <br>
        <!-- <form action="/listing/new" method="get">
        <button>Create New List</button>
    </form> -->

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for(let list of allList) { %>
                <a href="/listing/<%= list._id %>" class="listing-link">
                    <div class="card">
                        <img src="<%= list.image %>" class="card-img-top" alt="Listing Image" style="height : 20rem;">
                        <div class="card-img-overlay">
                            hi
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= list.title %>
                                </b>
                                <br>
                                &#8377 <%= list.price ? list.price.toLocaleString("en-IN") : "N/A" %> /night
                            </p>
                        </div>
                    </div>
                </a>    
                <% } %>
        </div>

    </body>