<% layout("layouts/boilerplate") %>
    <div class="row">
        <h2 class="col-6 offset-3">Login into WanderLust</h2>
        <div class="col-6 offset-3">
            <form action="/login" method="post" class="needs-validation" novalidate>
                <div class="mb-3 mt-2">
                    <label class="form-label" for="username">Enter title</label>
                    <input type="text" name="username" id="username"
                        class="form-control" required>
                    <div class="invalid-feedback">Please add the Username!</div>
                </div>
                <div class="mb-3 mt-2">
                    <label class="form-label" for="password">Enter Password</label>
                    <input type="password" name="password" id="password"
                        class="form-control" required>
                    <div class="invalid-feedback">Please add the Password!</div>
                </div>
                
                <button class="btn btn-success">Login</button>

            </form>
        </div>
    </div>